# ─── Database ───────────────────────────────────────────────────────────────
# Compose forces the API and seeder to use its local Postgres service.
# This value supports running the services outside Compose.
POSTGRES_URL=postgresql://fleet_user:fleet_pass@postgres:5432/fleet_db

# ─── API Security ────────────────────────────────────────────────────────────
JWT_SECRET=your_secure_jwt_secret_here

# ─── Demo Login ──────────────────────────────────────────────────────────────
DEMO_USERNAME=admin
DEMO_PASSWORD=your_secure_password_here

# ─── AI Agent ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ─── Streaming (auto-configured in docker compose; override for external) ────
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
TELEMETRY_TOPIC=telemetry

# ─── Redis (auto-configured in docker compose) ───────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Seeder ──────────────────────────────────────────────────────────────────
# balanced: 1K vehicles x 7 days; full: 100K x 1 day; demo: 50 x 14 days.
SEED_MODE=balanced
# Optional overrides: SEED_VEHICLES, SEED_DAYS, SEED_FLEETS, SEED_SEGMENT_SAMPLE
SEED_STREAM_EVENTS=60
SKIP_IF_SEEDED=true

VITE_API_BASE=/api
CORS_ORIGINS=http://localhost:80,http://localhost:5173