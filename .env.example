# ─── Database ───────────────────────────────────────────────────────────────
# Leave blank to use the local Postgres container (docker compose default).
# Set to your Supabase URL to use hosted data.
POSTGRES_URL=postgresql://fleet_user:fleet_pass@postgres:5432/fleet_db

# ─── API Security ────────────────────────────────────────────────────────────
JWT_SECRET=your_secure_jwt_secret_here

# ─── Demo Login ──────────────────────────────────────────────────────────────
DEMO_USERNAME=admin
DEMO_PASSWORD=your_secure_password_here

# ─── AI Agent ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ─── Streaming (auto-configured in docker compose; override for external) ────
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
TELEMETRY_TOPIC=telemetry

# ─── Redis (auto-configured in docker compose) ───────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Seeder (tune for faster/slower startup) ─────────────────────────────────
# SEED_MODE controls the scale profile:
#   demo  — 50 vehicles × 14 days  (fast, good for local dev)
#   full  — 100K vehicles × 1 day  (production-scale, multiprocessed, ~10-20 min)
SEED_MODE=demo

# Override vehicle/day counts (ignored when SEED_MODE sets the defaults)
SEED_VEHICLES=50
SEED_DAYS=14
SEED_STREAM_EVENTS=60
SKIP_IF_SEEDED=true

# In full mode, how many vehicles to run the segmentation engine over
# (raw telemetry for ALL 100K vehicles is in Postgres; this controls analytics coverage)
SEED_SEGMENT_SAMPLE=500

VITE_API_BASE=/api
CORS_ORIGINS=http://localhost:80,http://localhost:5173